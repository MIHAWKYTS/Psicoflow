# ===========================
# PsiGen - Variáveis de Ambiente
# ===========================

# --- Banco de Dados ---
DATABASE_URL="postgresql://psigen:psigen_secret@localhost:5432/psigen_db?schema=public"

# --- Autenticação (JWT) ---
# OBRIGATÓRIO: mínimo 32 caracteres aleatórios. Gere com: openssl rand -base64 32
JWT_SECRET="TROCAR_POR_UM_SEGREDO_FORTE_EM_PRODUCAO"
JWT_EXPIRES_IN="7d"
# OBRIGATÓRIO: segredo separado para o painel admin. Gere com: openssl rand -base64 32
ADMIN_JWT_SECRET="TROCAR_POR_OUTRO_SEGREDO_FORTE_EM_PRODUCAO"

# --- Mercado Pago ---
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# --- Asaas (cobrança) ---
# Ambiente: "sandbox" (testes) ou "production" (produção)
ASAAS_ENVIRONMENT="sandbox"
# API Key obtida em: Asaas → Configurações → Integrações → Chave de API
ASAAS_API_KEY=""
# Token para validar webhooks recebidos do Asaas
ASAAS_WEBHOOK_TOKEN=""

# --- Evolution API (WhatsApp) ---
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PsiGen"

# --- UploadThing (upload de arquivos) ---
# Token obtido em: uploadthing.com/dashboard → seu App → API Keys → Token
UPLOADTHING_TOKEN="TROCAR_PELO_TOKEN_BASE64"

# --- Email (Gmail SMTP) ---
# Conta Gmail usada como remetente
GMAIL_USER="psigensuport@gmail.com"
# App Password gerada em: myaccount.google.com → Segurança → Senhas de app
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# --- Feature Flags ---
FEATURE_PRONTUARIO_ANEXOS="false"

# --- Landing Page ---
# Número do WhatsApp da equipe para CTA da landing page (formato: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=""
