# ===========================
# PsicoFlow - Variáveis de Ambiente
# ===========================

# --- Banco de Dados ---
DATABASE_URL="postgresql://psicoflow:SENHA_REMOVIDA@localhost:5432/psicoflow_db?schema=public"
DIRECT_URL="postgresql://psicoflow:SENHA_REMOVIDA@localhost:5432/psicoflow_db?schema=public"

# --- Autenticação (JWT) ---
JWT_SECRET="TROCAR_POR_UM_SEGREDO_FORTE_EM_PRODUCAO"
JWT_EXPIRES_IN="7d"

# --- Mercado Pago ---
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# --- Evolution API (WhatsApp) ---
# EVOLUTION_API_URL: URL base da sua instância da Evolution API (auto-hospedada ou nuvem).
#   Exemplo local:  http://localhost:8080
#   Exemplo nuvem:  https://api.suaempresa.com
# EVOLUTION_API_KEY: Chave de autenticação global da Evolution API (campo "apikey" nos headers).
#   Obtenha em: Painel da Evolution API → API Keys → Global Key
# ATENÇÃO: Estes são os nomes CANÔNICOS usados em todo o projeto PsicoFlow.
#   Não crie aliases como WHATSAPP_API_URL ou WA_KEY — isso causará inconsistência.
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="PsicoFlow"

# --- UploadThing (upload de arquivos) ---
# Token obtido em: uploadthing.com/dashboard → seu App → API Keys → Token
UPLOADTHING_TOKEN="TROCAR_PELO_TOKEN_BASE64"

# --- Feature Flags ---
FEATURE_PRONTUARIO_ANEXOS="false"
