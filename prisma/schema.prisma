generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Tenant principal — representa uma clínica ou profissional autônomo.
/// Todas as demais tabelas referenciam o tenant para isolamento multi-tenant (LGPD).
model Tenant {
  id                    String                 @id @default(uuid()) @db.Uuid
  nomeClinica           String                 @map("nome_clinica")
  documento             String
  statusAssinatura      StatusAssinatura       @default(trial) @map("status_assinatura")
  isActive              Boolean                @default(true) @map("is_active")
  dataFimTrial          DateTime               @map("data_fim_trial")
  mpCustomerId          String?                @map("mp_customer_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  auditLogs             AuditLog[]
  clinicalCases         ClinicalCase[]
  clinicalEvolutions    ClinicalEvolution[]
  clinicalRecords       ClinicalRecord[]
  financialTransactions FinancialTransaction[]
  patients              Patient[]
  sessions              Session[]
  tasks                 Task[]
  users                 User[]
  whatsappInstances     WhatsAppInstance[]

  @@map("tenants")
}

/// Usuário do sistema — psicólogo administrador, psicólogo associado ou secretária.
model User {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  nome                String
  email               String               @unique
  cpf                 String?
  senhaHash           String               @map("senha_hash")
  role                UserRole             @default(psicologo)
  ativo               Boolean              @default(true)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  clinicalCases       ClinicalCase[]
  clinicalEvolutions  ClinicalEvolution[]  @relation("AutorEvolucao")
  clinicalRecords     ClinicalRecord[]     @relation("AutorProntuario")
  passwordResetTokens PasswordResetToken[]
  invalidatedTokens   InvalidatedToken[]
  auditLogs           AuditLog[]
  tasks               Task[]
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

/// Instância de conexão WhatsApp via Evolution API.
/// Cada psicólogo escaneia seu QR Code para conectar.
model WhatsAppInstance {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @map("tenant_id") @db.Uuid
  instanceName  String                @map("instance_name")
  tokenConexao  String?               @map("token_conexao")
  statusConexao StatusConexaoWhatsApp @default(desconectado) @map("status_conexao")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("whatsapp_instances")
}

/// Paciente vinculado a um tenant.
model Patient {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @map("tenant_id") @db.Uuid
  nome                  String
  cpf                   String?
  dataNascimento        DateTime?              @map("data_nascimento")
  responsavelLegal      String?                @map("responsavel_legal")
  genero                String?
  profissao             String?
  estadoCivil           String?                @map("estado_civil")
  endereco              String?
  email                 String?
  telefoneWhatsapp      String?                @map("telefone_whatsapp")
  status                StatusPaciente         @default(ativo)
  frequenciaSessoes     FrequenciaSessoes?     @map("frequencia_sessoes")
  valorSessaoPadrao     Decimal?               @map("valor_sessao_padrao") @db.Decimal(10, 2)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  clinicalRecords       ClinicalRecord[]
  financialTransactions FinancialTransaction[]
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions              Session[]
  tasks                 Task[]

  @@index([tenantId])
  @@map("patients")
}

/// Sessão agendada entre psicólogo e paciente.
model Session {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  patientId          String              @map("patient_id") @db.Uuid
  dataHoraInicio     DateTime            @map("data_hora_inicio")
  dataHoraFim        DateTime            @map("data_hora_fim")
  status             StatusSessao        @default(agendada)
  lembreteEnviado    Boolean             @default(false) @map("lembrete_enviado")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  clinicalEvolutions ClinicalEvolution[]
  clinicalRecords    ClinicalRecord[]
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([dataHoraInicio])
  @@map("sessions")
}

/// Prontuário eletrônico — cabeçalho estruturado com 5 blocos clínicos.
/// Protegido pela LGPD. Apenas psicólogos têm acesso. Secretária é bloqueada.
model ClinicalRecord {
  id                  String              @id @default(uuid()) @db.Uuid
  tenantId            String              @map("tenant_id") @db.Uuid
  patientId           String              @map("patient_id") @db.Uuid
  sessionId           String?             @map("session_id") @db.Uuid
  usuarioAutorId      String              @map("usuario_autor_id") @db.Uuid
  contratoTerapeutico String?             @map("contrato_terapeutico")
  anamnese            String?
  avaliacaoHipotese   String?             @map("avaliacao_hipotese")
  planoTrabalho       String?             @map("plano_trabalho")
  encerramento        String?
  dataEncerramento    DateTime?           @map("data_encerramento")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  evolucoes           ClinicalEvolution[]
  patient             Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  session             Session?            @relation(fields: [sessionId], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  autor               User                @relation("AutorProntuario", fields: [usuarioAutorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([sessionId])
  @@map("clinical_records")
}

/// Evolução clínica por sessão — vinculada ao prontuário-mestre do paciente.
model ClinicalEvolution {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  clinicalRecordId String         @map("clinical_record_id") @db.Uuid
  sessionId        String?        @map("session_id") @db.Uuid
  autorId          String         @map("autor_id") @db.Uuid
  dataHora         DateTime       @map("data_hora")
  temas            String
  intervencoes     String
  respostaPaciente String?        @map("resposta_paciente")
  encaminhamentos  String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  clinicalRecord   ClinicalRecord @relation(fields: [clinicalRecordId], references: [id], onDelete: Cascade)
  session          Session?       @relation(fields: [sessionId], references: [id])
  autor            User           @relation("AutorEvolucao", fields: [autorId], references: [id], onDelete: Cascade)
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([clinicalRecordId])
  @@index([sessionId])
  @@map("clinical_evolutions")
}

/// Transações financeiras — receitas e despesas.
/// Integração com Mercado Pago para links de pagamento.
model FinancialTransaction {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @map("tenant_id") @db.Uuid
  patientId       String?            @map("patient_id") @db.Uuid
  tipo            TipoTransacao
  categoria       CategoriaTransacao
  descricao       String?
  valor           Decimal            @db.Decimal(10, 2)
  statusPagamento StatusPagamento    @default(pendente) @map("status_pagamento")
  dataVencimento  DateTime           @map("data_vencimento")
  dataPagamento   DateTime?          @map("data_pagamento")
  formaPagamento  FormaPagamento?    @map("forma_pagamento")
  parcelas        Int?               @default(1)
  mpPaymentId     String?            @map("mp_payment_id")
  mpLinkPagamento String?            @map("mp_link_pagamento")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  patient         Patient?           @relation(fields: [patientId], references: [id])
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([dataVencimento])
  @@index([statusPagamento])
  @@map("financial_transactions")
}

/// Gestão de Tarefas (Kanban / To-Do)
model Task {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  usuarioId      String       @map("usuario_id") @db.Uuid
  patientId      String?      @map("patient_id") @db.Uuid
  titulo         String
  descricao      String?
  status         StatusTarefa @default(pendente)
  dataVencimento DateTime?    @map("data_vencimento")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  patient        Patient?     @relation(fields: [patientId], references: [id])
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario        User         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([usuarioId])
  @@map("tasks")
}

/// Casos Clínicos e Supervisão (Anotações, Uploads)
model ClinicalCase {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  usuarioId      String   @map("usuario_id") @db.Uuid
  titulo         String
  descricao      String?
  hipoteses      String?
  documentosUrls String[] @map("documentos_urls")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario        User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([usuarioId])
  @@map("clinical_cases")
}

/// Token para recuperação de senha — expira em 1h.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

/// Token JWT invalidado — blacklist para logout e troca de senha.
model InvalidatedToken {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jti])
  @@index([expiresAt])
  @@map("invalidated_tokens")
}

/// Registro de auditoria para conformidade com LGPD — acesso a prontuários clínicos.
model AuditLog {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  acao      AuditAcao
  recurso   String
  recursoId String     @map("recurso_id")
  ip        String?
  criadoEm DateTime   @default(now()) @map("criado_em")
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([criadoEm])
  @@map("audit_logs")
}

enum StatusAssinatura {
  trial
  ativo
  inadimplente
  cancelado
}

enum UserRole {
  admin
  psicologo_admin
  psicologo
  secretaria
}

enum StatusConexaoWhatsApp {
  desconectado
  qr_code_pendente
  conectado
}

enum StatusPaciente {
  ativo
  inativo
}

enum FrequenciaSessoes {
  semanal
  quinzenal
  mensal
}

enum StatusSessao {
  agendada
  realizada
  cancelada
  falta
}

enum TipoTransacao {
  receita
  despesa
}

enum CategoriaTransacao {
  consultorio
  pessoal
}

enum AuditAcao {
  VIEW
  CREATE
  UPDATE
  DELETE
}

enum StatusPagamento {
  pendente
  pago
  cancelado
}

enum StatusTarefa {
  pendente
  em_andamento
  concluida
}

enum FormaPagamento {
  dinheiro
  pix
  cartao
}
